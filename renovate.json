{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/New_York",
  "dependencyDashboard": false,
  "osvVulnerabilityAlerts": true,
  "kustomize": {
    "fileMatch": ["(^|/)kustomization\\.ya?ml$"]
  },
  "helmv3": {
    "fileMatch": ["(^|/)Chart\\.ya?ml$"]
  },
  "argocd": {
    "fileMatch": ["\\.ya?ml$"]
  },
  "packageRules": [
    {
      "matchManagers": ["argocd"],
      "groupName": "ArgoCD Application targetRevision bumps",
      "commitMessageTopic": "{{depName}} Application source"
    },
    {
      "matchManagers": ["helmv3", "kustomize"],
      "groupName": "Helm chart versions"
    },
    {
      "matchDatasources": ["docker"],
      "groupName": "container image tags"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Velero loads its provider plugins as init containers declared in values.additional.yaml. No built-in manager looks there: helm-values only matches values.yaml, and the kustomize manager only reads helmCharts entries. Uses managerFilePatterns rather than the deprecated fileMatch used by the built-in managers above.",
      "managerFilePatterns": ["/(^|/)values\\.additional\\.ya?ml$/"],
      "matchStrings": ["image:\\s*(?<depName>velero/velero-plugin-[a-z0-9-]+):(?<currentValue>v[\\w.-]+)"],
      "datasourceTemplate": "docker"
    }
  ]
}
